{
  "expo": {
    "name": "PocketVerse",
    "slug": "v2has",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pocketverse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#08080F",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#08080F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketverse.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSPhotoLibraryUsageDescription": "PocketVerse lets you use your own photos as your avatar. Images never leave your device."
      }
    },
    "android": {
      "package": "com.pocketverse.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#08080F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/favicon-32.png",
      "name": "PocketVerse",
      "shortName": "PocketVerse",
      "themeColor": "#08080F",
      "backgroundColor": "#08080F",
      "description": "Twenty-eight games, one avatar, one inventory, one save file. Offline-first, no account, no network."
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PocketVerse lets you use your own photos as your avatar. Images never leave your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#08080F",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4335ff5a-d00c-451a-92f3-fe0d585fe985"
      }
    },
    "owner": "iammadproberlys-team"
  }
}
