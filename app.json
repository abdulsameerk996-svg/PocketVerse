{
  "expo": {
    "name": "Donut Tycoon",
    "slug": "v2has",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pocketverse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#160F0B",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#160F0B",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketverse.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.pocketverse.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#160F0B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/favicon-32.png",
      "name": "Donut Tycoon",
      "shortName": "Donut Tycoon",
      "themeColor": "#160F0B",
      "backgroundColor": "#160F0B",
      "description": "Two games, one arcade: Donut Tycoon's idle café empire and Neon Rings' bounce-and-launch reflex runs. Offline-first, no account, no network."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#160F0B",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4335ff5a-d00c-451a-92f3-fe0d585fe985"
      }
    },
    "owner": "iammadproberlys-team"
  }
}
