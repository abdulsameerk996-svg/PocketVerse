{
  "expo": {
    "name": "PocketVerse",
    "slug": "v2has",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pocketverse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#08080F",
    "splash": {
      "backgroundColor": "#08080F",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketverse.app",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSPhotoLibraryUsageDescription": "PocketVerse lets you use your own photos as your avatar. Images never leave your device."
      }
    },
    "android": {
      "package": "com.pocketverse.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#08080F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PocketVerse lets you use your own photos as your avatar. Images never leave your device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080F",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4335ff5a-d00c-451a-92f3-fe0d585fe985"
      }
    },
    "owner": "iammadproberlys-team"
  }
}
