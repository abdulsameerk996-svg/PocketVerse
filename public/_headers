# Cloudflare Pages response headers.
#
# Everything in `public/` is copied verbatim into `dist/` by `expo export`, and
# Pages reads this file from the root of the deployed directory.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Metro emits content-hashed filenames, so these are safe to cache forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell and the worker must never be served stale, or a deploy cannot
# take effect until the cache expires.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json
