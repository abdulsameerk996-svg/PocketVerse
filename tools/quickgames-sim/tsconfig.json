{
  "//": "Standalone on purpose, like tools/frontier-sim. The app tsconfig extends expo/tsconfig.base which is incompatible with the classic node resolution this CommonJS build needs.",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "../../src",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] }
  },
  "files": [
    "../../src/core/game/quick.ts",
    "../../src/core/utils/rng.ts",
    "../../src/games/stackrush/logic.ts",
    "../../src/games/colorsnap/logic.ts",
    "../../src/games/survive60/logic.ts",
    "../../src/games/hookrun/logic.ts",
    "../../src/games/towerdef/logic.ts",
    "../../src/games/dodgerain/logic.ts",
    "../../src/games/onetap/logic.ts",
    "../../src/games/nummerge/logic.ts",
    "../../src/games/lasersurvive/logic.ts",
    "../../src/games/memrush/logic.ts",
    "../../src/games/orbitguard/logic.ts"
  ]
}
