{
  "//": "Standalone on purpose, like tools/penfight-sim and tools/audio-sim. The app's tsconfig extends expo/tsconfig.base, which sets customConditions and is incompatible with the classic node resolution this CommonJS build needs.",
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "../../src",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "files": [
    "../../src/games/frontier/types.ts",
    "../../src/games/frontier/content.ts",
    "../../src/games/frontier/world.ts",
    "../../src/games/frontier/sim.ts",
    "../../src/core/utils/rng.ts"
  ]
}
